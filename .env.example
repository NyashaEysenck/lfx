# Optional. The pipeline authenticates to Vertex AI with Application Default
# Credentials, not a key:  gcloud auth application-default login
#
# GEMINI_API_KEY is NOT used. A Cloud-console Gemini key targets
# generativelanguage.googleapis.com, which bills a prepaid balance separate from
# your Cloud credits and returns 429 "prepayment credits depleted".
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
